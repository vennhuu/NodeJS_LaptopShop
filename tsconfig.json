{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "baseUrl": "." ,
    "paths": {
      "config/*": ["./src/config/*"] , 
      "controller/*": ["./src/controller/*"] ,
      "models/*": ["./src/models/*"] ,
      "routes/*": ["./src/routes/*"] ,
      "service/*": ["./src/service/*"] ,
    }
  }
}