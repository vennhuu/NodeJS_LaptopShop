<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
            $(document).ready(() => {
                const avatarFile = $("#avatarFile");
                avatarFile.change(function (e) {
                    const imgURL = URL.createObjectURL(e.target.files[0]);
                    $("#avatarPreview").attr("src", imgURL);
                    $("#avatarPreview").css({ "display": "block" });
                });
            });
        </script>
</head>
<body>
    <div>Update user detail <%= user.id %></div>
    <div style="width:600px ; margin:auto">
        <h3 style="padding: 10px 0">Update User ID = <%= user.id %></h3>
        <form action="/handle-update-user" method="post" enctype="multipart/form-data">

            <input type="hidden" name="id" value="<%= user.id %>">
            
            <div class="mb-3">
                <label>Name</label>
                <input name="fullName" type="text" class="form-control" value="<%= user.fullName %>" >
            </div>

            <div class="mb-3">
                <label>Email</label>
                <input name="username" type="email" class="form-control" value="<%= user.username %>" >
            </div>
            <div class="row">
                <div class="mb-3 col-6">
                    <label class="form-label">Phone Nunber</label>
                    <input class="form-control" name="phone" value="<%= user.phone %>">
                </div>
                <!-- role -->
                <div class="mb-3 col-6">
                    <label class="form-label">Role</label>
                    <select class="form-select" name="role">
                        <% roles.forEach((role,index) => { %>
                            <option 
                                value="<%= role.id %>"
                                <%= user.roleId === role.id ? 'selected' : '' %>
                            >
                                <%= role.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label for="formFile" class="form-label">Avatar</label>
                <input name="avatar" class="form-control" type="file" id="avatarFile" accept=".png , .jpg , .jpeg">
            </div>

            <% if (user.avatar) { %>
                <img style="max-height: 250px; max-width: 500px; display: block;" alt="avatar Preview" id="avatarPreview" src="/images/<%= user.avatar %>"/>
            <% } else { %>
                <img style="max-height: 250px; max-width: 500px; display: none;" alt="avatar Preview" id="avatarPreview" />
            <% } %>
            <div class="mb-3">
                <label>Password</label>
                <input name="password" type="password" class="form-control" value="Password" >
            </div>

            <div class="mb-3">
                <label>Address</label>
                <textarea name="address" type="text" class="form-control" row="2"><%= user.address %></textarea>
            </div>

            <div class="mb-3">
                <a href="/"><button type="submit" class="btn btn-primary">Update</button></a>
            </div>
        </form>
    </div>
    
</body>
</html>