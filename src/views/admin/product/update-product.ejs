<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
            $(document).ready(() => {
                const avatarFile = $("#avatarFile");
                avatarFile.change(function (e) {
                    const imgURL = URL.createObjectURL(e.target.files[0]);
                    $("#avatarPreview").attr("src", imgURL);
                    $("#avatarPreview").css({ "display": "block" });
                });
            });
        </script>
</head>
<body>
    <div>Update Product detail <%= product.id %></div>
    <div style="width:600px ; margin:auto">
        <h3 style="padding: 10px 0">Update Product ID = <%= product.id %></h3>
        <form action="/handle-update-product" method="post" enctype="multipart/form-data">

            <input type="hidden" name="id" value="<%= product.id %>">
            
            <div class="mb-3">
                <label>Name</label>
                <input name="name" type="text" class="form-control" value="<%= product.name %>" >
            </div>

            <div class="mb-3">
                <label>Price</label>
                <input name="price" type="number" class="form-control" value="<%= product.price %>" >
            </div>

            <div class="mb-3">
                <label>Detail Description</label>
                <textarea name="detailDesc" type="text" class="form-control" row="3"><%= product.detailDesc %></textarea>
            </div>

            <div class="row">
                <div class="mb-3 col-6">
                    <label class="form-label">Short Description</label>
                    <input type="text" class="form-control" name="shortDesc" value="<%= product.shortDesc %>">
                </div>
                <div class="mb-3 col-6">
                    <label class="form-label">Quantity</label>
                    <input type="number" class="form-control" name="quantity" value="<%= product.quantity %>">
                </div>
            </div>
            <div class="row">
                <div class="mb-3 col-6">
                    <label class="form-label">Factory</label>
                    <select class="form-select" name="factory">
                        <option value="APPLE" <%= product.factory === 'APPLE' ? 'selected' : '' %>>
                            Apple (MacBook)
                        </option>

                        <option value="ASUS" <%= product.factory === 'ASUS' ? 'selected' : '' %>>
                            Asus
                        </option>

                        <option value="LENOVO" <%= product.factory === 'LENOVO' ? 'selected' : '' %>>
                            Lenovo
                        </option>

                        <option value="DELL" <%= product.factory === 'DELL' ? 'selected' : '' %>>
                            Dell
                        </option>

                        <option value="LG" <%= product.factory === 'LG' ? 'selected' : '' %>>
                            LG
                        </option>

                        <option value="ACER" <%= product.factory === 'ACER' ? 'selected' : '' %>>
                            Acer
                        </option>
                    </select>
                </div>

                <div class="mb-3 col-6">
                    <label class="form-label">Target</label>
                    <select class="form-select" name="target">
                        <option value="GAMING" <%= product.target === 'GAMING' ? 'selected' : '' %>>
                            Gaming
                        </option>

                        <option value="SINHVIEN_VANPHONG" <%= product.target === 'SINHVIEN_VANPHONG' ? 'selected' : '' %>>
                            Sinh viên - văn phòng
                        </option>

                        <option value="THIET_KE_DO_HOA" <%= product.target === 'THIET_KE_DO_HOA' ? 'selected' : '' %>>
                            Thiết kế đồ họa
                        </option>

                        <option value="MONG_NHE" <%= product.target === 'MONG_NHE' ? 'selected' : '' %>>
                            Mỏng nhẹ
                        </option>

                        <option value="DOANH_NHAN" <%= product.target === 'DOANH_NHAN' ? 'selected' : '' %>>
                            Doanh nhân
                        </option>
                    </select>
                </div>
            <div class="mb-3">
                <label for="formFile" class="form-label">Image</label>
                <input name="avatar" class="form-control" type="file" id="avatarFile" accept=".png , .jpg , .jpeg">
            </div>

            <% if (product.image) { %>
                <img style="max-height: 250px; max-width: 500px; display: block;" alt="avatar Preview" id="avatarPreview" src="/images/<%= product.image %>"/>
            <% } else { %>
                <img style="max-height: 250px; max-width: 500px; display: none;" alt="avatar Preview" id="avatarPreview" />
            <% } %>

            <div class="mb-3">
                <a href="/admin/product"><button type="submit" class="btn btn-primary">Update</button></a>
            </div>
        </form>
    </div>
    
</body>
</html>