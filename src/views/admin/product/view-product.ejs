<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

</head>
<body>
    <div>View Product detail <%= product.id %></div>
    <div style="width:600px ; margin:auto">
    <h3 style="padding: 10px 0">View detail Product ID = <%= product.id %></h3>
        <div class="mb-3">
            <label>Name</label>
            <input name="name" type="text" class="form-control" placeholder="<%= product.name %>" disabled>
        </div>

        <div class="mb-3">
            <label>Price</label>
            <input name="price" class="form-control" placeholder="<%= product.price %>" disabled>
        </div>

        <div class="mb-3">
            <label>Detail Desc</label>
            <input name="detailDesc" class="form-control" placeholder="<%= product.detailDesc %>" disabled>
        </div>

        <div class="row">
            <div class="mb-3 col-6">
                <label class="form-label">Short Des</label>
                <input type="text" class="form-control" name="shortDesc" placeholder="<%= product.shortDesc %>" disabled>
            </div>
            <div class="mb-3 col-6">
                <label class="form-label">Quantity</label>
                <input type="number" class="form-control" name="quantity" placeholder="<%= product.quantity %>" disabled>
            </div>
        </div>

        <div class="row">
            <div class="mb-3 col-6">
                <label class="form-label">Factory</label>
                <input class="form-control" name="factory" placeholder="<%= product.factory %>" disabled>

            </div>
            <div class="mb-3 col-6">
                <label class="form-label">Target</label>
                <input class="form-control" name="quantity" placeholder="<%= product.target %>" disabled>
            </div>
        </div>

        <div class="mb-3">
            <label for="formFile" class="form-label">Image</label>
        </div>
        <% if (product.image) { %>
            <img style="max-height: 250px; max-width: 500px; display: block;" alt="avatar Preview" id="avatarPreview" src="/images/<%= product.image %>"/>
        <% } else { %>
            <img style="max-height: 250px; max-width: 500px; display: none;" alt="avatar Preview" id="avatarPreview" />
        <% } %>


        <div class="mb-3">
            <a href="/admin/product"><button class="btn btn-primary">Back</button></a>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y" crossorigin="anonymous"></script>
</body>
</html>